# VISIONFORGE Environment Configuration Example
# Copy this file to .env for local development

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://visionforge_user:visionforge_password@localhost:5432/visionforge_db
DB_CONNECT_TIMEOUT=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# AI Pipeline Settings (Phase 5+)
AI_CONFIDENCE_THRESHOLD=0.45
AI_INFERENCE_FPS=5
CROWD_THRESHOLD_HIGH=40
LOITERING_THRESHOLD_SECONDS=15
EVENT_COOLDOWN_SECONDS=10
